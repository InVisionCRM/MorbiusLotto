# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies (root and any subdirectory)
node_modules
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage
/cypress/videos
/cypress/screenshots
/cypress/downloads

# next.js
/.next/
/out/

# production
/build

# hardhat
/contracts/node_modules
/contracts/cache
/contracts/artifacts
/contracts/.env

# server — generated / runtime (build from server/src in deploy)
server/dist/
server/logs/

# server uploads (admin table images/videos)
server/uploads/

# local design mockups & scratch docs (not shipped)
/docs

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
.env.local
.env.example
.enc.json
.env.production
.env.development
.env.test
.env.testnet
.env.mainnet
.env.pulsechain
.env.pulsechainTestnet
.env.pulsechainMainnet

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
.env*.local

# Serwist (generated service worker)
public/sw*
public/swe-worker*

# cursor (IDE / debug logs)
.cursor

# claude code (session worktrees — local scratch, never commit)
.claude/worktrees/

# internal audit notes (local reference only)
/audit

# poker anchor editor (/poker-layout) dev scratch save — never commit
lib/poker-seat-anchors.saved.json
