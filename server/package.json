{
  "name": "blackjack-server",
  "version": "1.0.0",
  "description": "Stake.com-style Blackjack Server",
  "main": "dist/server.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/server.js",
    "dev": "ts-node src/server.ts",
    "watch": "nodemon --exec ts-node src/server.ts",
    "simulate:blackjack": "ts-node src/scripts/simulate-blackjack-house-edge.ts",
    "tournament:bot": "ts-node src/scripts/tournament-bot-flow.ts",
    "tournament:bot:freeroll": "TOURNAMENT_BOT_MODE=freeroll ts-node src/scripts/tournament-bot-flow.ts"
  },
  "dependencies": {
    "express": "^4.18.2",
    "ws": "^8.14.2",
    "pg": "^8.11.3",
    "@neondatabase/serverless": "^0.7.2",
    "cors": "^2.8.5",
    "helmet": "^7.1.0",
    "express-rate-limit": "^7.1.5",
    "viem": "^1.19.9",
    "ethers": "^6.8.1",
    "crypto": "^1.0.1",
    "uuid": "^9.0.1",
    "dotenv": "^16.3.1",
    "zod": "^3.22.4",
    "winston": "^3.11.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/ws": "^8.5.9",
    "@types/pg": "^8.10.9",
    "@types/cors": "^2.8.16",
    "@types/uuid": "^9.0.7",
    "@types/node": "^20.10.0",
    "typescript": "^5.3.3",
    "ts-node": "^10.9.1",
    "nodemon": "^3.0.2"
  }
}