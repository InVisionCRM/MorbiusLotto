{
  "name": "blackjack-server",
  "version": "1.0.0",
  "description": "Stake.com-style Blackjack Server",
  "main": "dist/server.js",
  "scripts": {
    "build": "tsc",
    "prestart": "npm run build || true",
    "start": "node -r dotenv/config dist/server.js",
    "dev": "ts-node -r dotenv/config src/server.ts",
    "watch": "nodemon --exec 'ts-node -r dotenv/config src/server.ts'",
    "simulate:blackjack": "ts-node src/scripts/simulate-blackjack-house-edge.ts",
    "tournament:bot": "ts-node src/scripts/tournament-bot-flow.ts",
    "tournament:bot:freeroll": "TOURNAMENT_BOT_MODE=freeroll ts-node src/scripts/tournament-bot-flow.ts",
    "poker:bot": "ts-node src/scripts/poker-bot.ts",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:integration": "jest --runInBand --selectProjects integration",
    "postinstall": "(cd node_modules/@chevtek/poker-engine && npm run build) || true"
  },
  "dependencies": {
    "@chevtek/poker-engine": "^1.1.2",
    "@neondatabase/serverless": "^0.7.2",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "crypto": "^1.0.1",
    "dotenv": "^16.3.1",
    "ethers": "^6.8.1",
    "express": "^4.18.2",
    "express-rate-limit": "^7.1.5",
    "helmet": "^7.1.0",
    "multer": "^2.0.2",
    "pg": "^8.11.3",
    "siwe": "^3.0.0",
    "uuid": "^9.0.1",
    "viem": "^1.19.9",
    "winston": "^3.11.0",
    "ws": "^8.14.2",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.7",
    "@types/cors": "^2.8.16",
    "@types/express": "^4.17.21",
    "@types/jest": "^29.5.14",
    "@types/multer": "^2.0.0",
    "@types/node": "^20.10.0",
    "@types/pg": "^8.10.9",
    "@types/uuid": "^9.0.7",
    "@types/ws": "^8.5.9",
    "jest": "^29.7.0",
    "jest-util": "^29.7.0",
    "nodemon": "^3.0.2",
    "ts-jest": "^29.4.6",
    "ts-node": "^10.9.1",
    "typescript": "^5.3.3"
  }
}
